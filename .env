# Get this from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=123456:replace-me
# Your personal numeric Telegram chat ID. Use /whoami with your bot to discover it.
TELEGRAM_ADMIN_CHAT_ID=123456789
# Generate a long random value. Telegram sends it back in the webhook header.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# Generate a separate long random value for trusted trading backend services.
EVENT_INGEST_SECRET=replace-with-a-different-long-random-string
# Public HTTPS URL where Telegram can reach this service; no trailing slash.
PUBLIC_BASE_URL=https://bot.example.com
PORT=3001
